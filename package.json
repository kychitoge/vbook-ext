{
  "name": "vbook-tool",
  "version": "3.1.0",
  "description": "VBook 3.1: Modular & AI-Agent Ready CLI for Extension Developers",
  "author": "kychi",
  "main": "tools/cli/index.js",
  "bin": {
    "vbook": "./tools/cli/index.js"
  },
  "scripts": {
    "vbook": "node .agents/skills/vbook-extensions/scripts/vbook.js",
    "vbook:connect": "node .agents/skills/vbook-extensions/scripts/vbook.js connect",
    "vbook:test": "node .agents/skills/vbook-extensions/scripts/vbook.js test",
    "vbook:install": "node .agents/skills/vbook-extensions/scripts/vbook.js install",
    "vbook:build": "node .agents/skills/vbook-extensions/scripts/vbook.js build",
    "vbook:testall": "node .agents/skills/vbook-extensions/scripts/vbook.js testall",
    "vbook:audit": "node .agents/skills/vbook-extensions/scripts/vbook.js testall",
    "ext:create": "node tools/cli/index.js ext --mode create",
    "ext:edit": "node tools/cli/index.js ext --mode edit",
    "ext:validate": "node tools/cli/index.js validate",
    "ext:verify": "node tools/cli/index.js verify",
    "build:ext": "node tools/cli/index.js build",
    "build:catalog": "node tools/cli/index.js build-catalog",
    "build:vsix": "node tools/build-vsix.js",
    "skill:sync": "node tools/cli/index.js sync-skill",
    "ref:sync": "node tools/cli/index.js sync-ref",
    "encrypt:obfuscate": "node tools/encrypt/obfuscate.js",
    "encrypt:aes": "node tools/encrypt/encrypt.js",
    "encrypt:pipeline": "node tools/encrypt/pipeline.js",
    "encrypt:remote": "node tools/encrypt/remote-encrypt.js",
    "encrypt:decode": "node tools/encrypt/decoder.js",
    "test:local": "node tools/cli/local-runner.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "acorn": "^8.16.0",
    "adm-zip": "^0.5.17",
    "archiver": "^7.0.1",
    "axios": "^1.15.0",
    "cheerio": "^1.2.0",
    "commander": "^12.1.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "javascript-obfuscator": "^4.1.2",
    "playwright": "^1.60.0",
    "string-argv": "^0.3.2",
    "terser": "^5.48.0"
  }
}
